# API Keys (fill in with your actual keys)
SAKURA_API_KEY="your-sakura-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Provider request timeout in finite, positive seconds.
API_TIMEOUT=10.0

# External book data is denied unless each provider/category is explicitly listed.
# Categories: source_text, translation_text, book_knowledge, evaluation_samples
PROVIDER_DATA_POLICY={}

# Provider failover sends failed primary prompts to Gemini when enabled.
ENABLE_GEMINI_FALLBACK=false

# Service Base URLs (default endpoints)
SAKURA_BASE_URL="http://127.0.0.1:6006/v1"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
