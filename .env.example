# API Keys (fill in with your actual keys)
SAKURA_API_KEY="your-sakura-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
# Optional user-selected channel aliases. The user-approved minimum JOJO/JYQF
# role scopes are documented in docs/model-provider-configuration-plan.md.
# Selecting an alias does not enable it; PROVIDER_DATA_POLICY stays deny-all
# until explicitly configured, and endpoint credentials must be verified.
JOJO_API_KEY="your-jojo-api-key"
JYQF_API_KEY="your-jyqf-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Provider request timeout in finite, positive seconds.
API_TIMEOUT=10.0

# External book data is denied unless each provider/category is explicitly listed.
# Categories: source_text, translation_text, book_knowledge, evaluation_samples
# Configure only the confirmed minimum categories for each provider's assigned
# stages. JOJO/JYQF authorization does not cover Gemini, Notion, or other uses.
PROVIDER_DATA_POLICY={}

# Optional: use only the source-verified, explicitly reviewed TM snapshot for retrieval.
# TM_REVIEWED_PATH="Knowledge/translation_memory_reviewed.json"

# Provider failover sends failed primary prompts to Gemini when enabled.
ENABLE_GEMINI_FALLBACK=false

# JYQF is used only as an explicit retryable-error fallback for JOJO stages.
# It is subject to its own per-category grant and API key.
ENABLE_JYQF_FALLBACK=false

# Service Base URLs (default endpoints)
SAKURA_BASE_URL="http://127.0.0.1:6006/v1"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
JOJO_BASE_URL="https://max2.jojocode.com/v1"
JYQF_BASE_URL="https://jyqf.me/v1"
